# Optional public settings
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
# Public contact shown on legal pages; leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_REPO_URL=

# AI features (server-only secret; never prefix with NEXT_PUBLIC_). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override models (defaults: openai/gpt-oss-120b, falling back to openai/gpt-oss-20b; both free tier)
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
